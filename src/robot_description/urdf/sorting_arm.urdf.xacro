<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="sorting_arm">

  <material name="blue">
    <color rgba="0.1 0.3 0.85 1"/>
  </material>

  <material name="orange">
    <color rgba="1 0.35 0.05 1"/>
  </material>

  <material name="gray">
    <color rgba="0.55 0.58 0.62 1"/>
  </material>


  <!-- ==================== BASE ==================== -->

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.06"/>
      <geometry>
        <cylinder radius="0.15" length="0.12"/>
      </geometry>
      <material name="gray"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.06"/>
      <geometry>
        <cylinder radius="0.15" length="0.12"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.06"/>
      <mass value="5"/>
      <inertia ixx="0.05" ixy="0" ixz="0"
               iyy="0.05" iyz="0" izz="0.05"/>
    </inertial>
  </link>


  <!-- ==================== LINK 1 ==================== -->

  <link name="link1">
    <visual>
      <geometry>
        <cylinder radius="0.07" length="0.22"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <collision>
      <geometry>
        <cylinder radius="0.07" length="0.22"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="2"/>
      <inertia ixx="0.02" ixy="0" ixz="0"
               iyy="0.02" iyz="0" izz="0.02"/>
    </inertial>
  </link>

  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0.17"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="30" velocity="1.5"/>
  </joint>


  <!-- ==================== LINK 2 ==================== -->

  <link name="link2">
    <visual>
      <origin xyz="0 0 0.22"/>
      <geometry>
        <box size="0.10 0.10 0.44"/>
      </geometry>
      <material name="orange"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.22"/>
      <geometry>
        <box size="0.10 0.10 0.44"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.22"/>
      <mass value="2"/>
      <inertia ixx="0.04" ixy="0" ixz="0"
               iyy="0.04" iyz="0" izz="0.01"/>
    </inertial>
  </link>

  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 0.12"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.2" upper="2.2" effort="30" velocity="1.5"/>
  </joint>


  <!-- ==================== LINK 3 ==================== -->

  <link name="link3">
    <visual>
      <origin xyz="0 0 0.20"/>
      <geometry>
        <box size="0.08 0.08 0.40"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.20"/>
      <geometry>
        <box size="0.08 0.08 0.40"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.20"/>
      <mass value="1.5"/>
      <inertia ixx="0.03" ixy="0" ixz="0"
               iyy="0.03" iyz="0" izz="0.008"/>
    </inertial>
  </link>

  <joint name="joint3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0 0 0.44"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.5" upper="2.5" effort="25" velocity="1.5"/>
  </joint>


  <!-- ==================== LINK 4 ==================== -->

  <link name="link4">
    <visual>
      <geometry>
        <cylinder radius="0.055" length="0.16"/>
      </geometry>
      <material name="gray"/>
    </visual>

    <collision>
      <geometry>
        <cylinder radius="0.055" length="0.16"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.8"/>
      <inertia ixx="0.01" ixy="0" ixz="0"
               iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>

  <joint name="joint4" type="revolute">
    <parent link="link3"/>
    <child link="link4"/>
    <origin xyz="0 0 0.40"/>
    <axis xyz="1 0 0"/>
    <limit lower="-3.14" upper="3.14" effort="15" velocity="2"/>
  </joint>


  <!-- ==================== LINK 5 ==================== -->

  <link name="link5">
    <visual>
      <geometry>
        <cylinder radius="0.05" length="0.14"/>
      </geometry>
      <material name="gray"/>
    </visual>

    <collision>
      <geometry>
        <cylinder radius="0.05" length="0.14"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.6"/>
      <inertia ixx="0.008" ixy="0" ixz="0"
               iyy="0.008" iyz="0" izz="0.008"/>
    </inertial>
  </link>

  <joint name="joint5" type="revolute">
    <parent link="link4"/>
    <child link="link5"/>
    <origin xyz="0 0 0.12"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.2" upper="2.2" effort="12" velocity="2"/>
  </joint>


  <!-- ==================== LINK 6 ==================== -->

  <link name="link6">
    <visual>
      <geometry>
        <cylinder radius="0.045" length="0.12"/>
      </geometry>
      <material name="gray"/>
    </visual>

    <collision>
      <geometry>
        <cylinder radius="0.045" length="0.12"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.4"/>
      <inertia ixx="0.005" ixy="0" ixz="0"
               iyy="0.005" iyz="0" izz="0.005"/>
    </inertial>
  </link>

  <joint name="joint6" type="revolute">
    <parent link="link5"/>
    <child link="link6"/>
    <origin xyz="0 0 0.12"/>
    <axis xyz="1 0 0"/>
    <limit lower="-3.14" upper="3.14" effort="10" velocity="2"/>
  </joint>


  <!-- ==================== TOOL ==================== -->

  <link name="tool_link">
    <visual>
      <geometry>
        <box size="0.12 0.08 0.05"/>
      </geometry>
      <material name="orange"/>
    </visual>

    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.001" ixy="0" ixz="0"
               iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="tool_fixed" type="fixed">
    <parent link="link6"/>
    <child link="tool_link"/>
    <origin xyz="0 0 0.10"/>
  </joint>


  <!-- ==================== GRIPPER ==================== -->

  <link name="gripper_left_finger">
    <visual>
      <origin xyz="0.05 0 0"/>
      <geometry>
        <box size="0.10 0.012 0.06"/>
      </geometry>
      <material name="gray"/>
    </visual>

    <collision>
      <origin xyz="0.05 0 0"/>
      <geometry>
        <box size="0.10 0.012 0.06"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0.05 0 0"/>
      <mass value="0.08"/>
      <inertia ixx="0.0001" ixy="0" ixz="0"
               iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="gripper_left_finger_joint" type="prismatic">
    <parent link="tool_link"/>
    <child link="gripper_left_finger"/>
    <origin xyz="0.02 0.045 0.025"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0" upper="0.03" effort="20" velocity="0.05"/>
    <dynamics damping="0.2" friction="0.1"/>
  </joint>


  <link name="gripper_right_finger">
    <visual>
      <origin xyz="0.05 0 0"/>
      <geometry>
        <box size="0.10 0.012 0.06"/>
      </geometry>
      <material name="gray"/>
    </visual>

    <collision>
      <origin xyz="0.05 0 0"/>
      <geometry>
        <box size="0.10 0.012 0.06"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0.05 0 0"/>
      <mass value="0.08"/>
      <inertia ixx="0.0001" ixy="0" ixz="0"
               iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="gripper_right_finger_joint" type="prismatic">
    <parent link="tool_link"/>
    <child link="gripper_right_finger"/>
    <origin xyz="0.02 -0.045 0.025"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="0.03" effort="20" velocity="0.05"/>
    <dynamics damping="0.2" friction="0.1"/>
  </joint>


  <!-- ==================== ROS 2 CONTROL ==================== -->

  <ros2_control name="GazeboSimSystem" type="system">

    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <joint name="joint1">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint2">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint3">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint4">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint5">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint6">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="gripper_left_finger_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="gripper_right_finger_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

  </ros2_control>


  <!-- ==================== GAZEBO ROS 2 CONTROL ==================== -->

  <gazebo>
    <plugin filename="libgz_ros2_control-system.so"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">

      <parameters>
        $(env HOME)/robotics_ws/.ros2_control_controllers.yaml
      </parameters>

    </plugin>
  </gazebo>


  <!-- Anchor the robot base to the Gazebo world -->
  <link name="world"/>

  <joint name="world_fixed_joint" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
</robot>
